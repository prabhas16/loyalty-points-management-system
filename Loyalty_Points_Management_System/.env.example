# Configure these values for your local environment. Never commit your real .env file.
DB_HOST=localhost
DB_USER=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=loyalty_db
SECRET_KEY=replace-with-a-random-secret
SESSION_COOKIE_SECURE=false

# Optional connection for the dedicated synthetic benchmark database
BENCHMARK_DB_HOST=localhost
BENCHMARK_DB_USER=YOUR_USERNAME
BENCHMARK_DB_PASSWORD=YOUR_PASSWORD
BENCHMARK_DB_NAME=loyalty_benchmark
